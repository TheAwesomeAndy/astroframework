{
  "registry_id": "naf.condition.registry.hellenistic.v1",
  "milestone": "v0.4.0a",
  "status": "schema_frozen_no_calculations",
  "model_bundle": "naf.condition.hellenistic.brennan-reconstruction.v1",
  "epistemic_scope": "Astrological rule definitions and implementation contracts. These rules are historical/model conventions, not physical measurements or empirical validation of astrology.",
  "object_scope": {
    "classical_planet": {
      "applicability": "full",
      "objects": ["Sun", "Moon", "Mercury", "Venus", "Mars", "Jupiter", "Saturn"]
    },
    "outer_planet": {
      "applicability": "not_applicable",
      "objects": ["Uranus", "Neptune", "Pluto"],
      "note": "No Hellenistic essential-dignity inheritance. A later modern/hybrid model requires its own rule-set ID."
    },
    "lot": {
      "applicability": "derived_point_only",
      "note": "Lots may have rulers, houses, aspects, and timing relations, but do not silently inherit planetary essential dignity."
    },
    "angle": {
      "applicability": "positional_only",
      "objects": ["ASC", "MC", "DSC", "IC"],
      "note": "Angles are geometric/positional points, not planets."
    },
    "node": {
      "applicability": "tradition_dependent",
      "note": "No planetary dignity logic is inherited by default."
    }
  },
  "status_vocabulary": ["present", "absent", "not_applicable", "unsupported", "indeterminate", "not_implemented"],
  "interval_convention": {
    "longitude_domain_deg": "[0,360)",
    "sign_local_degree_domain": "[0,30)",
    "bound_intervals": "[start_deg,end_deg)",
    "exact_30_deg": "Normalize to 0 degrees of the following sign before bound lookup.",
    "historical_translation_note": "Historical degree counts are represented computationally as half-open zero-based intervals. Thus a six-degree first bound is [0,6), and an exact boundary at 6.000... belongs to the following bound.",
    "tolerance_policy": "No epsilon is embedded in the rule table. Numeric tolerance belongs to implementation/test policy and must be versioned separately if introduced."
  },
  "sources": [
    {
      "id": "brennan.2017.ch7.sect",
      "type": "modern_reconstruction",
      "citation": "Christopher Brennan, Hellenistic Astrology: The Study of Fate and Fortune (2017), Chapter 7, Sect, pp. 190-196.",
      "supports": ["planetary_sect", "sect_condition"],
      "notes": "Brennan presents Sun/Jupiter/Saturn as diurnal; Moon/Venus/Mars as nocturnal; Mercury as common/variable, with Ptolemy and Porphyry assigning morning-star Mercury to diurnal sect and evening-star Mercury to nocturnal sect."
    },
    {
      "id": "brennan.2017.ch8.domicile",
      "type": "modern_reconstruction",
      "citation": "Brennan (2017), Chapter 8, Domicile Rulership, pp. 232ff.",
      "supports": ["domicile", "adversity"]
    },
    {
      "id": "brennan.2017.ch8.exaltation",
      "type": "modern_reconstruction",
      "citation": "Brennan (2017), Chapter 8, Exaltations and Depressions, pp. 242ff.",
      "supports": ["exaltation", "depression"]
    },
    {
      "id": "brennan.2017.table8.1.triplicity",
      "type": "modern_reconstruction",
      "citation": "Brennan (2017), Table 8.1, Standard Triplicity Rulership Scheme, p. 267.",
      "supports": ["triplicity"],
      "primary_witnesses": ["Dorotheus, Carmen Astrologicum 1.1:2-4", "Vettius Valens, Anthology 2.1"],
      "notes": "Ptolemy's alternate triplicity scheme is explicitly excluded from v1."
    },
    {
      "id": "brennan.2017.table8.3.egyptian_bounds",
      "type": "modern_reconstruction",
      "citation": "Brennan (2017), Table 8.3, The Egyptian Bounds, p. 277.",
      "supports": ["egyptian_bounds"],
      "primary_witnesses": ["Dorotheus, original verse via Hephaestio, Apotelesmatika 1.1", "Vettius Valens, Anthology 1.3"],
      "notes": "Ptolemaic and Chaldean bounds are explicitly excluded from v1."
    },
    {
      "id": "brennan.2017.ch10.angular_places",
      "type": "modern_reconstruction",
      "citation": "Brennan (2017), Chapter 10, The Angles or Pivots and Angular Triads, pp. 325-331.",
      "supports": ["whole_sign_place_angularity"],
      "notes": "This initial classifier is distinct from quadrant-house dynamic strength in Chapter 11."
    },
    {
      "id": "brennan.2017.ch9.overcoming",
      "type": "modern_reconstruction",
      "citation": "Brennan (2017), Chapter 9, Overcoming, pp. 311-315.",
      "supports": ["overcoming"],
      "primary_witnesses": ["Porphyry, Introduction 20", "Antiochus, Summary 10"],
      "notes": "Implementation deferred to relational-condition phase."
    },
    {
      "id": "brennan.2017.ch14.reception",
      "type": "modern_reconstruction",
      "citation": "Brennan (2017), Chapter 14, Mitigating Conditions: Reception, pp. 491-494.",
      "supports": ["reception", "exchange"],
      "primary_witnesses": ["Porphyry, Introduction 22", "Antiochus, Summary 11", "Rhetorius, Compendium 40"],
      "notes": "Hellenistic reception/exchange must not be silently replaced by later Medieval mutual-reception definitions."
    },
    {
      "id": "brennan.2017.ch14.bonification_maltreatment",
      "type": "modern_reconstruction",
      "citation": "Brennan (2017), Chapter 14, Conditions of Bonification and Maltreatment, pp. 461-494.",
      "supports": ["bonification", "maltreatment", "mitigation"],
      "notes": "Brennan explicitly describes this chapter as a reconstruction from divergent Antiochus-derived definitions; compound rules are therefore source-sensitive and not implementation-ready in v0.4.0a."
    }
  ],
