{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "naf-null-laboratory-result-v0.4.6.schema.json",
  "title": "Noetic Atlas Null Model Laboratory Result v0.4.6",
  "type": "object",
  "required": [
    "schema",
    "model_id",
    "version",
    "run_id",
    "state_fingerprint",
    "iterations",
    "rng",
    "observed_metrics",
    "null_models",
    "metric_definitions",
    "families",
    "experiments",
    "epistemic_contract"
  ],
  "properties": {
    "schema": {
      "const": "naf.research.null_laboratory_result.v0.4.6"
    },
    "model_id": {
      "const": "naf.research.null_model_laboratory.v0.4.6"
    },
    "version": {
      "const": "0.4.6"
    },
    "run_id": {
      "type": "string",
      "pattern": "^NAF-NULLRUN-"
    },
    "state_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "iterations": {
      "type": "integer",
      "minimum": 19
    },
    "rng": {
      "type": "object",
      "required": [
        "algorithm",
        "base_seed"
      ],
      "properties": {
        "algorithm": {
          "const": "mulberry32-v1"
        },
        "base_seed": {
          "type": "string"
        }
      }
    },
    "observed_metrics": {
      "type": "array"
    },
    "null_models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "model_id",
          "version",
          "question",
          "preserves",
          "randomizes",
          "limitations",
          "admissible_metric_ids"
        ]
      }
    },
    "metric_definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "metric_id",
          "version",
          "definition",
          "formula",
          "direction",
          "implementation_hash",
          "admissible_null_models"
        ]
      }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "family_id",
          "null_model_id",
          "procedure",
          "family_size",
          "metric_ids"
        ]
      }
    },
    "experiments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/experiment"
      }
    },
    "epistemic_contract": {
      "type": "object",
      "required": [
        "population_frequency",
        "interpretation",
        "no_cross_null_aggregate_score"
      ]
    }
  },
  "$defs": {
    "experiment": {
      "type": "object",
      "required": [
        "schema",
        "experiment_id",
        "run_id",
        "atlas_version",
        "metric",
        "null_model",
        "rng",
        "iterations",
        "observed_value",
        "null_distribution",
        "p_value_method",
        "raw_p",
        "adjusted_p",
        "empirical_percentile",
        "effect_position",
        "preserved_properties",
        "randomized_properties",
        "assumptions",
        "limitations",
        "multiple_testing",
        "departure_evaluation",
        "simulation_quality",
        "population_frequency",
        "interpretation_status",
        "no_cross_null_aggregate_score"
      ],
      "properties": {
        "schema": {
          "const": "naf.research.null_experiment.v0.4.6"
        },
        "experiment_id": {
          "type": "string",
          "pattern": "^NAF-NULLEXP-"
        },
        "run_id": {
          "type": "string"
        },
        "atlas_version": {
          "const": "0.4.6"
        },
        "metric": {
          "type": "object",
          "required": [
            "metric_id",
            "version",
            "implementation_hash",
            "direction"
          ]
        },
        "null_model": {
          "type": "object",
          "required": [
            "id",
            "version",
            "question",
            "preserves",
            "randomizes",
            "limitations"
          ]
        },
        "rng": {
          "type": "object",
          "required": [
            "algorithm",
            "base_seed",
            "derived_seed_uint32"
          ]
        },
        "iterations": {
          "type": "integer",
          "minimum": 19
        },
        "observed_value": {
          "type": "number"
        },
        "null_distribution": {
          "type": "object",
          "required": [
            "count",
            "values_hash",
            "hash_algorithm"
          ]
        },
        "p_value_method": {
          "type": "object",
          "required": [
            "name",
            "upper_tail_formula",
            "lower_tail_formula",
            "two_sided_formula"
          ]
        },
        "raw_p": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "adjusted_p": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "empirical_percentile": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "effect_position": {
          "type": "object",
          "required": [
            "observed",
            "null_mean",
            "null_median",
            "null_sd",
            "gaussian_assumption"
          ]
        },
        "preserved_properties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "randomized_properties": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "multiple_testing": {
          "type": "object",
          "required": [
            "procedure",
            "family_id",
            "family_size",
            "rank"
          ]
        },
        "departure_evaluation": {
          "enum": [
            "departure-detected",
            "no-departure-detected"
          ]
        },
        "population_frequency": {
          "const": "unknown"
        },
        "interpretation_status": {
          "const": "withheld"
        },
        "no_cross_null_aggregate_score": {
          "const": true
        },
        "simulation_quality": {
          "type": "object",
          "required": [
            "status",
            "reasons"
          ],
          "properties": {
            "status": {
              "enum": [
                "adequate",
                "limited",
                "invalid"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
