{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"naf-research-hypothesis-pack-v0.4.5.schema.json",
  "title":"Noetic Atlas Research Hypothesis Pack v0.4.5",
  "type":"object",
  "required":["schema","version","hypothesis_id","title","question","domain","regime","control_model","variants","execution_status","research_status","model_identity"],
  "properties":{
    "schema":{"const":"naf.research.hypothesis_pack.v0.4.5"},
    "version":{"const":"0.4.5"},
    "hypothesis_id":{"type":"string","minLength":1},
    "title":{"type":"string","minLength":1},
    "question":{"type":"string","minLength":1},
    "domain":{"type":"string","minLength":1},
    "regime":{"const":"experimental"},
    "control_model":{"type":"string","minLength":1},
    "variants":{"type":"array","items":{"type":"object","required":["variant_id","label","model_id","parameters","execution_status"]}},
    "expected_structural_effects":{"type":"array","items":{"type":"string"}},
    "sources":{"type":"array"},
    "execution_status":{"type":"string"},
    "lifecycle":{"type":"object"},
    "research_status":{"type":"object","required":["geometry","derivation","historical_analogue","population_frequency","null_comparison","phenomenological_association","replication","interpretation"]},
    "model_identity":{"type":"object","required":["regime","model_id","version","hypothesis_id"]}
  },
  "additionalProperties":true
}
